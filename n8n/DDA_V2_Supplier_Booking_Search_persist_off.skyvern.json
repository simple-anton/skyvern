              "description": "Number of children, if specified.",
              "title": "Children Count"
            },
            "supplierHotelName": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "The name of the hotel as provided by the supplier.",
              "title": "Supplier Hotel Name"
            },
