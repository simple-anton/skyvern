              "description": "The primary name of the hotel.",
              "title": "Hotel Name"
            },
            "address": {
              "type": "string",
              "description": "The full address of the hotel.",
              "title": "Address"
            },
            "checkinDate": {
              "type": "string",
              "description": "Check-in date formatted as ISO-8601 (YYYY-MM-DD)",
              "title": "Check-in Date"
            },
            "checkoutDate": {
              "type": "string",
