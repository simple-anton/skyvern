        "ignore_workflow_system_prompt": false,
        "block_type": "task",
        "title": "Find_Booking",
        "url": "{{website_url}}",
        "navigation_goal": "\n        *** OBJECTIVE: Open details for Booking ID '{{booking_id}}' ***\n        1. Navigate to the top menu, hover over 'Booking', and select 'Hotel Bookings' from the dropdown.\n        2. Locate the search filter area on the page.\n        3. Select the 'All Dates' radio button.\n        4. **CRITICAL**: Clear any existing text in the 'Booking ID' input field.\n        5. Enter '{{booking_id}}' into the 'Booking ID' field.\n        6. Click the 'Search' button.\n        7. Wait for the search results to load in the table below.\n        8. Locate the booking in the table and click the 'Details' button in the 'Action' column.\n\n        ### FINAL VERIFICATION\n        - Ensure the page loaded is the detailed booking view for '{{booking_id}}'.\n    ",
        "data_extraction_goal": "",
        "complete_criterion": "The detailed booking window/page for Booking ID '{{booking_id}}' is open and details are visible.",
        "terminate_criterion": "A login or sign-in page requiring username/password is displayed instead of the authenticated back office, meaning the browser session is not logged in.",
        "data_schema": null,
        "error_code_mapping": null,
        "max_retries": 1,
        "max_steps_per_run": 8,
        "complete_on_download": false,
        "download_suffix": null,
        "parameter_keys": [],
